<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingTop="4dp">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/range_chip_group"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_day"
                style="@style/AppTheme.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"
                android:text="@string/button_status_day" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_week"
                style="@style/AppTheme.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_status_week" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_month"
                style="@style/AppTheme.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_status_month" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chip_year"
                style="@style/AppTheme.FilterChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/button_status_year" />

        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <com.google.android.material.chip.Chip
        android:id="@+id/chip_compare"
        style="@style/Widget.MaterialComponents.Chip.Filter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:checkable="true"
        android:text="@string/compare_previous" />

    <LinearLayout
        android:id="@+id/stats_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="2dp"
        android:paddingEnd="12dp"
        android:paddingBottom="2dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/stat_min"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="start"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/stat_avg"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/stat_max"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:textColor="?attr/colorAccent"
            android:textSize="11sp" />
    </LinearLayout>

    <com.github.mikephil.charting.charts.LineChart
        android:id="@+id/chart"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        android:padding="4dp" />

    <!-- Hidden legend TextViews used as label carriers for dataset naming -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:id="@+id/legend_temperature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/temperature"
                android:textColor="@color/material_blue_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_set_point"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_point"
                android:textColor="@color/material_pink_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_humidity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/humidity"
                android:textColor="@color/material_orange_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_barometer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Barometer"
                android:textColor="@color/material_green_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_counter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Counter"
                android:textColor="@color/material_indigo_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_powerusage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power Usage"
                android:textColor="@color/material_yellow_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_powerdeliv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Power Delivery"
                android:textColor="@color/material_deep_purple_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Value"
                android:textColor="@color/material_yellow_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_percentage2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Value 2"
                android:textColor="@color/material_orange_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_direction"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/direction"
                android:textColor="@color/material_deep_teal_500"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_sunpower"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sunpower"
                android:textColor="@color/material_deep_purple_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_speed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/speed"
                android:textColor="@color/material_amber_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_usage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/usage"
                android:textColor="@color/material_orange_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/rain"
                android:textColor="@color/material_light_green_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_co2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/co2"
                android:textColor="@color/material_blue_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_co2min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/co2min"
                android:textColor="@color/material_light_green_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_co2max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/co2max"
                android:textColor="@color/md_red_400"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_Lux"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Lux"
                android:textColor="@color/material_blue_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_Luxmin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Luxmin"
                android:textColor="@color/material_light_green_600"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_Luxmax"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Luxmax"
                android:textColor="@color/md_red_400"
                android:visibility="gone" />

            <TextView
                android:id="@+id/legend_LuxAvg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/LuxAvg"
                android:textColor="@color/md_yellow_400"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/empty_state"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="12dp"
            android:alpha="0.4"
            android:src="@drawable/ic_info" />

        <TextView
            android:id="@+id/empty_state_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:alpha="0.6"
            android:gravity="center"
            android:text="@string/no_data_for_range"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>